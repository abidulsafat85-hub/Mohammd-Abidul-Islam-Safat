# MessMate Environment Variables Configuration Example
# Copy this file to .env for local development

# Admin Authentication
ADMIN_INITIAL_PASSWORD=12345
JWT_SECRET=your-random-secret-key-at-least-32-chars-long

# Firebase Configuration (Required for strict production persistence)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=
ALLOW_MOCK_DB=false

# WhatsApp UltraMsg Gateway
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
WEBHOOK_SECRET=

# Scheduler Setting
# Set to 'true' on long-running node servers (e.g. AI Studio, Docker, VPS)
# Keep unset or 'false' on serverless platforms (e.g. Netlify, Vercel)
RUN_INTERNAL_SCHEDULER=false
